# Mistral API Key - Get from https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Custom port for backend server (default: 3001)
PORT=3001

# Production: Frontend URL for CORS (e.g., your Render frontend URL or custom domain)
# Examples:
# FRONTEND_URL=https://your-app.onrender.com
# FRONTEND_URL=https://yourdomain.com
# Leave unset if backend serves frontend from same domain

# Node Environment (development or production)
# NODE_ENV=production

# Firebase Admin Service Account (Recommended for production)
# Get from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire JSON file content as a single line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Memory Optimization Notes:
# - Backend payload limit: 25MB (prevents OOM on 512MB RAM servers)
# - Frontend file limit: 20MB (validates before upload)
# - Recommended max document size: 15-20 pages per file
