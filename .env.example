# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Google Gemini API Configuration (Required for OCR transcription)
# Get your free API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Firebase Project ID (for backend authentication)
FIREBASE_PROJECT_ID=ai-studio-applet-webapp-a82b5

# Firebase Service Account (Optional - for backend)
# Get from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire JSON content as a single line (no line breaks)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Production Frontend URL (for CORS)
# Only needed if frontend is on a different domain than backend
# FRONTEND_URL=https://your-frontend-domain.com

# Render.com Configuration (automatically provided)
# RENDER_EXTERNAL_URL is set automatically by Render

# Payload size limits: 25MB allows multi-page PDFs
# Gemini Flash processes pages in cloud with minimal server memory footprint (<50MB RAM)
