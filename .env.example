# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Firebase Project ID (for backend authentication)
FIREBASE_PROJECT_ID=ai-studio-applet-webapp-a82b5

# Firebase Service Account (Optional - for backend)
# Get from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire JSON content as a single line (no line breaks)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Production Frontend URL (for CORS)
# Only needed if frontend is on a different domain than backend
# FRONTEND_URL=https://your-frontend-domain.com

# Render.com Configuration (automatically provided)
# RENDER_EXTERNAL_URL is set automatically by Render

# Memory Optimization Settings
# Backend enforces 25MB payload limit to prevent OOM on 512MB RAM servers
# Frontend validates 20MB file size before upload
# Recommended: 10-15 pages per document for optimal performance

# Python Configuration (for PaddleOCR)
# Ensure python3 is installed and accessible in PATH
# Installation: pip install paddleocr paddlepaddle pillow

# Redis Configuration (Optional - for production rate limiting)
# REDIS_URL=redis://localhost:6379

# Monitoring & Logging (Optional)
# SENTRY_DSN=your_sentry_dsn_here
# LOG_LEVEL=info
