# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ── Google Gemini API Configuration ──────────────────────────────
# Get free API keys from https://aistudio.google.com/
# Option A: Comma-separated keys
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Named multi-key pool (supports up to 6 or more parallel keys)
# GEMINI_KEY_01=AIzaSy...
# GEMINI_KEY_02=AIzaSy...
# GEMINI_KEY_03=AIzaSy...
# GEMINI_KEY_04=AIzaSy...
# GEMINI_KEY_05=AIzaSy...
# GEMINI_KEY_06=AIzaSy...

# Model tier configuration
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash
GEMINI_MODEL_VERIFY=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Pacing & Concurrency Controls
# Number of page workers dispatched in parallel (default: matches number of keys, e.g. 6)
OCR_CONCURRENCY=6
# Requests per minute budget per individual key
GEMINI_RPM_PER_KEY=5
# Max in-flight requests per individual key
GEMINI_MAX_IN_FLIGHT_PER_KEY=1

# ── Backend Server Configuration ─────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Firebase Project Configuration ───────────────────────────────
FIREBASE_PROJECT_ID=ai-studio-applet-webapp-a82b5

# Firebase Service Account (Optional for local dev, recommended in production)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Production Frontend URL (for CORS) ───────────────────────────
# FRONTEND_URL=https://typed-doc.web.app
